# =============================================================================
# TraceBack Environment Configuration Template
# Copy this file to .env and customize with your own settings
# =============================================================================

# MongoDB Connection String
Mongo__ConnectionString=mongodb://localhost:27017
Mongo__Database=TraceBack

# JWT Authentication (at least 32 characters)
Jwt__Issuer=TraceBack
Jwt__Secret=replace_with_at_least_32_characters_secret_key_here

# Optional: Bootstrap initial Admin account on application startup
# BootstrapAdmin__Email=admin@campus.edu
# BootstrapAdmin__Password=ChangeMe123!Secure
# BootstrapAdmin__Name=Campus Administrator

