@model TraceBack.Controllers.ItemDetailPage
@using System.Security.Claims
@using TraceBack.Models
@{
    ViewData["Title"] = Model.Item.Title;
    ViewData["RouteArt"] = "details";
    var hasPhoto = !string.IsNullOrWhiteSpace(Model.Item.DisplayImageUrl);
}

<a class="btn btn-outline-secondary detail-report__back" asp-action="Index"><partial name="_Icon" model='"arrow-left"' /> Back to results</a>

<article class="detail-report">
    <div class="detail-report__layout">
        <header class="detail-report__heading">
            <div class="d-flex gap-2 flex-wrap">
                <partial name="_StatusBadge" model="Model.Item.Type" />
                <partial name="_StatusBadge" model="Model.Item.Status" />
            </div>
            <h1>@Model.Item.Title</h1>
        </header>
        <div class="detail-report__media-column">
            <figure class="detail-report__media">
                <div class="detail-report__photo">
                    @if (hasPhoto)
                    {
                        <img src="@Model.Item.DisplayImageUrl" alt="Photo of @Model.Item.Title" data-report-photo />
                        <div class="detail-report__photo-fallback" hidden>
                            <partial name="_Icon" model='"image-off"' />
                            <span>Photo unavailable</span>
                        </div>
                    }
                    else
                    {
                        <div class="detail-report__photo-fallback">
                            <partial name="_Icon" model='"image"' />
                            <span>No photo provided</span>
                        </div>
                    }
                </div>
                <figcaption>
                    @if (hasPhoto)
                    {
                        <span class="photo-supplied-caption">Photo supplied with this report.</span>
                        <span class="photo-error-caption">The report photo could not load.</span>
                    }
                    else
                    {
                        <text>No photo was added to this report.</text>
                    }
                </figcaption>
            </figure>
            <section class="detail-report__map" aria-labelledby="report-map-heading">
                @if (MapLocationRules.SafeStored(Model.Item.MapLocation) is { } point)
                {
                    <h2 id="report-map-heading" class="h5 d-flex align-items-center gap-2"><partial name="_Icon" model='"map-pin"' /> Saved map pin</h2>
                    <p class="form-text mb-2">Address unavailable for this pin. It marks the reporter’s selected point.</p>
                    <partial name="_ReportMap" model="(false, (MapLocation?)point)" />
                }
                else
                {
                    <h2 id="report-map-heading" class="h5">Location</h2>
                    <p class="mb-0">Map location not added to this older report.</p>
                }
            </section>
        </div>
        <div class="detail-report__content">
            <div class="detail-report__description" data-detail-description>
                <p id="report-description">@Model.Item.Description</p>
                <button type="button" aria-expanded="false" aria-controls="report-description" hidden>Read more</button>
            </div>
            <section class="detail-report__facts tb-panel" aria-labelledby="report-facts-heading">
                <h2 id="report-facts-heading">Report facts</h2>
                <partial name="_FactList" model="Model.Item" />
            </section>
            <dl class="detail-report__contact">
                <dt>Contact preference</dt>
                <dd>@Model.Item.ContactPreference</dd>
            </dl>
            <partial name="_ClaimPanel" model="Model" />
            @if (Model.IsOwner || Model.IsAdmin)
            {
                <section class="detail-report__actions tb-panel" aria-labelledby="report-actions-heading">
                    <h2 id="report-actions-heading">Manage this report</h2>
                    @if (Model.Item.Status == "Active")
                    {
                        <div class="detail-report__owner-controls">
                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Item.Id"><partial name="_Icon" model='"pencil"' />Edit report</a>
                            <partial name="_ConfirmationDialog" model='("Resolve", Model.Item.Id, "Mark this report resolved?", "This closes the report and makes its discussion read only.", "Mark resolved", false)' />
                        </div>
                    }
                    <div class="detail-report__owner-controls">
                        <partial name="_ConfirmationDialog" model='("Delete", Model.Item.Id, "Delete this report?", "This deletes the report and all of its claims. This cannot be undone.", "Delete report", true)' />
                    </div>
                    <noscript><p class="form-text">Enable JavaScript to confirm changes to this report.</p></noscript>
                </section>
            }
        </div>
    </div>
</article>

<section class="discussion" aria-labelledby="discussion-title" data-discussion
         data-comments-url="@Url.Content($"~/Items/{Model.Item.Id}/Comments")"
         data-current-user="@User.FindFirstValue(ClaimTypes.NameIdentifier)"
         data-is-admin="@User.IsInRole("Admin").ToString().ToLowerInvariant()"
         data-can-post="@((User.Identity?.IsAuthenticated == true && Model.Item.Status == "Active").ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div>
            <h2 id="discussion-title">Public discussion</h2>
            <p class="text-muted mb-0">Ask about this report here. Ownership details belong in a private claim.</p>
        </div>
    </div>
    <div class="discussion__panel">
    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="discussion-notice">Sign in to read and join the discussion.
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a>
        </p>
    }
    else
    {
        <form class="discussion-composer" aria-label="Comment composer" data-comment-form method="post"
              action="@Url.Content($"~/Items/{Model.Item.Id}/Comments")"
              enctype="multipart/form-data" hidden>
            @Html.AntiForgeryToken()
            <input type="hidden" name="parentId" data-parent-id />
            <p class="discussion-reply-label" data-reply-label hidden></p>
            <label for="comment-body" class="form-label fw-semibold">Your comment</label>
            <div class="discussion-input-surface">
                <textarea id="comment-body" class="form-control" name="body" rows="2" maxlength="2000"
                          placeholder="Write a comment…" aria-describedby="comment-help comment-error"></textarea>
                <div class="discussion-input-actions">
                    <button class="btn btn-outline-secondary" type="button" data-attach-image aria-label="Attach image" aria-describedby="comment-image-help"><partial name="_Icon" model='"image"' /></button>
                    <button class="btn btn-primary" type="submit" data-submit-comment aria-label="Post comment"><partial name="_Icon" model='"arrow-left"' /></button>
                </div>
            </div>
            <p id="comment-help" class="form-text">Write up to 2,000 characters, add one image, or both. Public comments are visible to signed-in viewers.</p>
            <input id="comment-image" type="file" name="imageFile" hidden
                   accept="image/jpeg,image/png,image/gif,image/webp" />
            <p id="comment-image-help" class="visually-hidden">JPEG, PNG, GIF, or WebP; up to 5 MiB.</p>
            <div data-image-preview hidden>
                <img alt="Selected image preview" />
                <button type="button" data-clear-image aria-label="Remove image"><span><partial name="_Icon" model='"trash-2"' /></span></button>
            </div>
            <div data-alt-field hidden>
                <label for="comment-alt" class="form-label fw-semibold">Describe the image</label>
                <input id="comment-alt" class="form-control" name="imageAlt" maxlength="200"
                       aria-describedby="comment-alt-help comment-error" />
                <p id="comment-alt-help" class="form-text">Required for an image; 1 to 200 characters.</p>
            </div>
            <p id="comment-error" class="discussion-error" role="alert" hidden></p>
            <div class="discussion-actions">
                <button type="button" class="btn btn-outline-secondary" data-cancel-reply hidden>Cancel reply</button>
                <span data-comment-pending hidden>Posting…</span>
            </div>
        </form>
        <noscript><p class="discussion-notice">Enable JavaScript to load and join the discussion.</p></noscript>
        <p class="discussion-notice" data-comment-readonly hidden="@(Model.Item.Status == "Active")">This report is no longer active. Its discussion is read only.</p>
        <p class="visually-hidden" role="status" aria-live="polite" data-discussion-announcement></p>
        <div class="discussion-thread" role="region" aria-label="Comment thread" tabindex="0" data-discussion-root hidden></div>
    }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/report-map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discussion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/detail-report.css" asp-append-version="true" />
    @if (Model.CanClaim)
    {
        <link rel="stylesheet" href="~/css/claim.css" asp-append-version="true" />
    }
}

@section Scripts {
    <script src="~/js/report-photo.js" asp-append-version="true" defer></script>
    <script src="~/js/item-details.js" asp-append-version="true" defer></script>
    <script src="~/lib/leaflet/leaflet.js" defer></script>
    <script src="~/js/report-map.js" asp-append-version="true" defer></script>
    <script src="~/js/discussion.js" asp-append-version="true" defer></script>
    <script src="~/js/confirmation-dialog.js" asp-append-version="true" defer></script>
    @if (Model.CanClaim)
    {
        <script src="~/js/claim.js" asp-append-version="true" defer></script>
    }
}
