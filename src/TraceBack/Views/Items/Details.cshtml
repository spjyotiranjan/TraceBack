@model TraceBack.Controllers.ItemDetailPage
@inject IConfiguration Configuration
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Item.Title;
}

<a class="back-link" asp-action="Index">← Back to results</a>

<div class="row g-4 mt-1 mb-5">
    <div class="col-lg-6">
        @if (!string.IsNullOrWhiteSpace(Model.Item.DisplayImageUrl))
        {
            <img class="detail-image" src="@Model.Item.DisplayImageUrl" alt="@Model.Item.Title" />
        }
        else
        {
            <div class="detail-placeholder" aria-hidden="true">TB</div>
        }
    </div>

    <div class="col-lg-6">
        <div class="d-flex gap-2 mb-3">
            <span class="badge badge-type">@Model.Item.Type</span>
            <span class="badge badge-status">@Model.Item.Status</span>
        </div>

        <h1>@Model.Item.Title</h1>
        <p class="lead text-muted">@Model.Item.Description</p>

        <dl class="detail-list">
            <div>
                <dt>Category</dt>
                <dd>@Model.Item.Category</dd>
            </div>
            <div>
                <dt>Location</dt>
                <dd>
                    @Model.Item.Location
                    @if (TraceBack.Models.MapLocationRules.SafeStored(Model.Item.MapLocation) is { } point)
                    {
                        <span class="d-block">Coordinates: @point.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture), @point.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)</span>
                        <a href="@TraceBack.Models.MapLocationRules.GoogleMapsUrl(point)" target="_blank" rel="noopener noreferrer">View in Google Maps</a>
                        <div class="map-preview" data-report-map="preview"
                             data-latitude="@point.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)"
                             data-longitude="@point.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture)"
                             data-tile-url="@(Configuration["MapTiles:UrlTemplate"] ?? "https://tile.openstreetmap.org/{z}/{x}/{y}.png")"
                             data-tile-attribution="@(Configuration["MapTiles:AttributionHtml"] ?? "&copy; OpenStreetMap contributors")"
                             data-max-zoom="@(Configuration["MapTiles:MaxZoom"] ?? "18")">
                            <div class="map-canvas" data-map-canvas aria-hidden="true"></div>
                            <p class="map-status" data-map-status role="status" aria-live="polite">Loading map preview…</p>
                            <button class="btn btn-outline-primary" type="button" data-map-retry hidden>Retry map preview</button>
                        </div>
                    }
                    else
                    {
                        <span class="d-block">Map location not available</span>
                    }
                </dd>
            </div>
            <div>
                <dt>Reported</dt>
                <dd>@Model.Item.DateReported.ToString("d MMM yyyy")</dd>
            </div>
            <div>
                <dt>Contact preference</dt>
                <dd>@Model.Item.ContactPreference</dd>
            </div>
        </dl>

        @if (Model.CanClaim)
        {
            <div class="action-panel">
                <h2 class="h5">Think this is yours?</h2>
                <p>Share details only the owner would know. Your message stays private.</p>
                <a class="btn btn-primary" asp-route="default" asp-route-controller="Claims" asp-route-action="Create" asp-route-itemId="@Model.Item.Id">Submit a claim</a>
            </div>
        }
        else if (User.Identity?.IsAuthenticated != true && Model.Item.Type == "Found" && Model.Item.Status == "Active")
        {
            <div class="action-panel">
                <h2 class="h5">Think this is yours?</h2>
                <p>Sign in to share private ownership details.</p>
                <a class="btn btn-primary"
                   asp-controller="Account"
                   asp-action="Login"
                   asp-route-returnUrl="@Url.RouteUrl("default", new { controller = "Claims", action = "Create", itemId = Model.Item.Id })">Sign in to claim</a>
            </div>
        }

        @if ((Model.IsOwner || Model.IsAdmin) && Model.Item.Status == "Active")
        {
            <div class="d-flex gap-2 flex-wrap mt-4">
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Item.Id">Edit report</a>
                <form asp-route="default" asp-route-controller="Items" asp-route-action="Resolve" asp-route-id="@Model.Item.Id" method="post">
                    <button class="btn btn-outline-secondary" type="submit" data-confirm="Mark this report resolved?">Mark resolved</button>
                </form>
            </div>
        }

        @if (Model.IsOwner || Model.IsAdmin)
        {
            <form asp-route="default" asp-route-controller="Items" asp-route-action="Delete" asp-route-id="@Model.Item.Id" method="post" class="mt-3">
                <button class="btn btn-outline-danger"
                        type="submit"
                        data-confirm="Delete this report and all of its claims? This cannot be undone.">Delete report</button>
            </form>
        }
    </div>
</div>

<section class="discussion" aria-labelledby="discussion-title" data-discussion
         data-comments-url="@Url.Content($"~/Items/{Model.Item.Id}/Comments")"
         data-current-user="@User.FindFirstValue(ClaimTypes.NameIdentifier)"
         data-is-admin="@User.IsInRole("Admin").ToString().ToLowerInvariant()"
         data-can-post="@((User.Identity?.IsAuthenticated == true && Model.Item.Status == "Active").ToString().ToLowerInvariant())">
    <div class="section-heading">
        <div>
            <h2 id="discussion-title">Public discussion</h2>
            <p class="text-muted mb-0">Ask about this report here. Ownership details belong in a private claim.</p>
        </div>
    </div>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="discussion-notice">Sign in to read and join the discussion.
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Sign in</a>
        </p>
    }
    else
    {
        <form class="discussion-composer" data-comment-form method="post"
              action="@Url.Content($"~/Items/{Model.Item.Id}/Comments")"
              enctype="multipart/form-data" hidden="@(Model.Item.Status != "Active")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="parentId" data-parent-id />
            <p class="discussion-reply-label" data-reply-label hidden></p>
            <label for="comment-body" class="form-label fw-semibold">Your comment</label>
            <textarea id="comment-body" class="form-control" name="body" rows="3" maxlength="2000"
                      aria-describedby="comment-help comment-error"></textarea>
            <p id="comment-help" class="form-text">Write up to 2,000 characters, add one image, or both. Public comments are visible to signed-in viewers.</p>
            <label for="comment-image" class="form-label fw-semibold">Image (optional)</label>
            <input id="comment-image" class="form-control" type="file" name="imageFile"
                   accept="image/jpeg,image/png,image/gif,image/webp" aria-describedby="comment-image-help comment-error" />
            <p id="comment-image-help" class="form-text">JPEG, PNG, GIF, or WebP; up to 5 MB.</p>
            <div data-image-preview hidden>
                <img alt="Selected image preview" />
                <button type="button" class="btn btn-outline-secondary" data-clear-image>Remove image</button>
            </div>
            <div data-alt-field hidden>
                <label for="comment-alt" class="form-label fw-semibold">Describe the image</label>
                <input id="comment-alt" class="form-control" name="imageAlt" maxlength="200"
                       aria-describedby="comment-alt-help comment-error" />
                <p id="comment-alt-help" class="form-text">Required for an image; 1 to 200 characters.</p>
            </div>
            <p id="comment-error" class="discussion-error" role="alert" hidden></p>
            <div class="discussion-actions">
                <button type="submit" class="btn btn-primary" data-submit-comment>Post comment</button>
                <button type="button" class="btn btn-outline-secondary" data-cancel-reply hidden>Cancel reply</button>
            </div>
        </form>
        @if (Model.Item.Status != "Active")
        {
            <p class="discussion-notice">This report is no longer active. Its discussion is read only.</p>
        }
        <p class="visually-hidden" role="status" aria-live="polite" data-discussion-announcement></p>
        <div data-discussion-root aria-busy="true"><p>Loading discussion…</p></div>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/report-map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discussion.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" defer></script>
    <script src="~/js/report-map.js" asp-append-version="true" defer></script>
    <script src="~/js/discussion.js" asp-append-version="true" defer></script>
}
