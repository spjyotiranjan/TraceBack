@model TraceBack.Controllers.BrowsePage
@{
    ViewData["Title"] = "Browse reports";
    ViewData["RouteArt"] = "browse";
    var search = Model.Search;
    var filters = new (string Name, string Label, string? Value)[]
    {
        (nameof(search.Type), "Type", search.Type),
        (nameof(search.Category), "Category", search.Category),
        (nameof(search.Location), "Location", search.Location),
        (nameof(search.Status), "Status", search.Status == "Active" ? null : search.Status)
    };
    var chips = new List<TraceBack.Controllers.FilterChip>();
    var route = Model.PageRoute(1);
    foreach (var filter in filters)
    {
        if (filter.Value is not { } value) { continue; }
        var remaining = new RouteValueDictionary(route);
        remaining.Remove(filter.Name);
        chips.Add(new(filter.Label, value, Url.Action("Index", "Items", remaining)!));
    }
    TraceBack.Controllers.FilterChip? queryChip = null;
    if (search.Query is { } query)
    {
        var remaining = new RouteValueDictionary(route);
        remaining.Remove(nameof(search.Query));
        queryChip = new("Search", query, Url.Action("Index", "Items", remaining)!);
    }
    var hasFilters = chips.Count > 0 || queryChip is not null;
    var foundOnly = search.Type == "Found" && chips.Count == 1 && queryChip is null;
}

<div class="tb-browse-page">
    <partial name="_ResultBoard" model="Model" />
    <partial name="_SearchFilters" model="Model" />

    @if (hasFilters)
    {
        <div class="browse-applied" role="group" aria-label="Applied filters">
            @if (!foundOnly)
            {
                <span class="browse-applied-label">Applied</span>
            }
            @foreach (var chip in chips)
            {
                <partial name="_FilterChip" model="chip" />
            }
            @if (!foundOnly)
            {
                <a class="btn btn-outline-secondary clear-all-filters" asp-controller="Items" asp-action="Index">Clear all</a>
            }
            @if (queryChip is not null)
            {
                <partial name="_FilterChip" model="queryChip" />
            }
        </div>
    }

    <section class="browse-results" aria-labelledby="browse-results-title">
        <div class="section-heading">
            <h2 id="browse-results-title">Results</h2>
        </div>
        @if (Model.LoadFailed)
        {
            var retry = Context.Request.PathBase.ToUriComponent() + Context.Request.Path.ToUriComponent() + Context.Request.QueryString.ToUriComponent();
            <partial name="_RecoveryContent" model='@(new RecoveryContent("Reports could not load", "Try again. Your filters will stay in place.", RecoveryArt.Service,
                Primary: new UiButton("Retry", Href: retry)))' />
        }
        else if (Model.Items.Count == 0)
        {
            var recovery = search.Page > 1
                ? new RecoveryContent("No reports on this page", "Return to the first page to see what's available with these filters.", RecoveryArt.Reports,
                    Primary: new UiButton("Back to page 1", ButtonTone.Secondary, Href: Url.Action("Index", "Items", route)))
                : hasFilters
                    ? new RecoveryContent("No reports match these filters", "Try fewer search words or clear a filter.", RecoveryArt.Search,
                        Primary: new UiButton("Clear filters", ButtonTone.Secondary, Href: Url.Action("Index", "Items")))
                    : new RecoveryContent("No active reports yet", "When someone posts a lost or found item, it will appear here.", RecoveryArt.Reports,
                        Primary: new UiButton("Report an item", Href: Url.RouteUrl("default", new { controller = "Items", action = "Create" })));
            <partial name="_RecoveryContent" model="recovery" />
        }
        else
        {
            <div class="tb-report-grid">
                @foreach (var item in Model.Items)
                {
                    <partial name="_ItemCard" model="new ReportCard(item, ReportCardVariant.Browse)" />
                }
            </div>
        }
    </section>

    <partial name="_Pagination" model="Model" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/home-browse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/browse.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/report-search.js" asp-append-version="true" defer></script>
    <script src="~/js/report-photo.js" asp-append-version="true" defer></script>
    <script src="~/js/browse-filters.js" asp-append-version="true" defer></script>
}
