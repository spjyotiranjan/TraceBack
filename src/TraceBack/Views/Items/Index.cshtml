@model TraceBack.Controllers.BrowsePage
@{
    ViewData["Title"] = "Browse reports";
    var filteredStatus = Model.Search.Status is "Resolved" or "Claimed";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Search.Query)
        || !string.IsNullOrWhiteSpace(Model.Search.Type)
        || !string.IsNullOrWhiteSpace(Model.Search.Category)
        || !string.IsNullOrWhiteSpace(Model.Search.Location)
        || filteredStatus;
}

<div class="page-heading">
    <p class="eyebrow">Explore reports</p>
    <h1>Browse items</h1>
    <p>Search what your campus has lost or found.</p>
</div>

<form asp-action="Index" method="get" class="filter-panel browse-filters mb-4" role="search">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label for="query" class="form-label">Search words</label>
            <input id="query"
                   name="Query"
                   class="form-control"
                   value="@Model.Search.Query"
                   placeholder="Item name or description" />
        </div>

        <div class="col-sm-6 col-lg-2">
            <label for="type" class="form-label">Type</label>
            <select id="type" name="Type" class="form-select">
                <option value="">All types</option>
                <option value="Lost" selected="@(Model.Search.Type == "Lost")">Lost</option>
                <option value="Found" selected="@(Model.Search.Type == "Found")">Found</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-2">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="Status" class="form-select">
                <option value="Active" selected="@(Model.Search.Status is null or "Active")">Active</option>
                <option value="Resolved" selected="@(Model.Search.Status == "Resolved")">Resolved</option>
                <option value="Claimed" selected="@(Model.Search.Status == "Claimed")">Claimed</option>
            </select>
        </div>

        <div class="col-sm-6 col-lg-2">
            <label for="category" class="form-label">Category</label>
            <input id="category"
                   name="Category"
                   class="form-control"
                   value="@Model.Search.Category"
                   placeholder="e.g. Electronics" />
        </div>

        <div class="col-sm-6 col-lg-2">
            <label for="location" class="form-label">Location</label>
            <input id="location"
                   name="Location"
                   class="form-control"
                   value="@Model.Search.Location"
                   placeholder="e.g. Library" />
        </div>

        <div class="col-12 browse-filter-actions">
            <button type="submit" class="btn btn-primary">Apply filters</button>
            <a class="btn btn-outline-primary" asp-action="Index">Clear filters</a>
        </div>
    </div>
</form>

<div class="section-heading browse-results-heading">
    <div>
        <h2 class="h4">Reports</h2>
        @if (!Model.LoadFailed)
        {
            <p class="text-muted mb-0">Showing @Model.Items.Count @(Model.Items.Count == 1 ? "report" : "reports") on page @Model.Search.Page</p>
        }
    </div>
</div>

@if (hasActiveFilters)
{
    <div class="active-filters" aria-label="Applied filters">
        @if (!string.IsNullOrWhiteSpace(Model.Search.Query))
        {
            <a class="filter-chip" href="@Url.Action("Index", new { type = Model.Search.Type, category = Model.Search.Category, location = Model.Search.Location, status = Model.Search.Status, page = 1 })" aria-label="Remove search words filter: @Model.Search.Query">Search: @Model.Search.Query <span aria-hidden="true">×</span></a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Search.Type))
        {
            <a class="filter-chip" href="@Url.Action("Index", new { query = Model.Search.Query, category = Model.Search.Category, location = Model.Search.Location, status = Model.Search.Status, page = 1 })" aria-label="Remove type filter: @Model.Search.Type">Type: @Model.Search.Type <span aria-hidden="true">×</span></a>
        }
        @if (filteredStatus)
        {
            <a class="filter-chip" href="@Url.Action("Index", new { query = Model.Search.Query, type = Model.Search.Type, category = Model.Search.Category, location = Model.Search.Location, page = 1 })" aria-label="Remove status filter: @Model.Search.Status">Status: @Model.Search.Status <span aria-hidden="true">×</span></a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Search.Category))
        {
            <a class="filter-chip" href="@Url.Action("Index", new { query = Model.Search.Query, type = Model.Search.Type, location = Model.Search.Location, status = Model.Search.Status, page = 1 })" aria-label="Remove category filter: @Model.Search.Category">Category: @Model.Search.Category <span aria-hidden="true">×</span></a>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Search.Location))
        {
            <a class="filter-chip" href="@Url.Action("Index", new { query = Model.Search.Query, type = Model.Search.Type, category = Model.Search.Category, status = Model.Search.Status, page = 1 })" aria-label="Remove location filter: @Model.Search.Location">Location: @Model.Search.Location <span aria-hidden="true">×</span></a>
        }
        <a class="clear-all-filters" asp-action="Index">Clear all filters</a>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="empty-state" role="alert">
        <h3 class="h5">Reports could not load. Try again.</h3>
        <a class="btn btn-primary" href="@Context.Request.Path@Context.Request.QueryString">Retry</a>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="empty-state">
        <h3 class="h5">@(hasActiveFilters ? "No reports match these filters." : "No active reports yet.")</h3>
        <p>@(hasActiveFilters ? "Try fewer search words or clear a filter." : "When someone posts a lost or found item, it will appear here.")</p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            @if (hasActiveFilters)
            {
                <a class="btn btn-outline-primary" asp-action="Index">Clear filters</a>
            }
            <a class="btn btn-primary" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <partial name="_ItemCard" model="item" />
            </div>
        }
    </div>
}

@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.Search.Page > 1))
{
<nav class="mt-4" aria-label="Result pages">
    <ul class="pagination">
        @if (Model.Search.Page > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-query="@Model.Search.Query"
                   asp-route-type="@Model.Search.Type"
                   asp-route-category="@Model.Search.Category"
                   asp-route-location="@Model.Search.Location"
                   asp-route-status="@Model.Search.Status"
                   asp-route-page="@(Model.Search.Page - 1)"
                   aria-label="Previous page">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled"><span class="page-link" aria-disabled="true">Previous</span></li>
        }

        <li class="page-item active">
            <span class="page-link" aria-current="page">@Model.Search.Page</span>
        </li>

        @if (Model.HasNext)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-query="@Model.Search.Query"
                   asp-route-type="@Model.Search.Type"
                   asp-route-category="@Model.Search.Category"
                   asp-route-location="@Model.Search.Location"
                   asp-route-status="@Model.Search.Status"
                   asp-route-page="@(Model.Search.Page + 1)"
                   aria-label="Next page">Next</a>
            </li>
        }
    </ul>
</nav>
}
