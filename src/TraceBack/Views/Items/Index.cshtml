@model TraceBack.Controllers.BrowsePage
@{
    ViewData["Title"] = "Browse reports";
    var chips = new List<TraceBack.Controllers.FilterChip>();
    if (!string.IsNullOrWhiteSpace(Model.Search.Query))
    {
        chips.Add(new("Search", Model.Search.Query, Url.Action("Index", "Items", new { type = Model.Search.Type, category = Model.Search.Category, location = Model.Search.Location, status = Model.Search.Status, page = 1 })!));
    }
    if (!string.IsNullOrWhiteSpace(Model.Search.Type))
    {
        chips.Add(new("Type", Model.Search.Type, Url.Action("Index", "Items", new { query = Model.Search.Query, category = Model.Search.Category, location = Model.Search.Location, status = Model.Search.Status, page = 1 })!));
    }
    if (Model.Search.Status is "Resolved" or "Claimed")
    {
        chips.Add(new("Status", Model.Search.Status, Url.Action("Index", "Items", new { query = Model.Search.Query, type = Model.Search.Type, category = Model.Search.Category, location = Model.Search.Location, page = 1 })!));
    }
    if (!string.IsNullOrWhiteSpace(Model.Search.Category))
    {
        chips.Add(new("Category", Model.Search.Category, Url.Action("Index", "Items", new { query = Model.Search.Query, type = Model.Search.Type, location = Model.Search.Location, status = Model.Search.Status, page = 1 })!));
    }
    if (!string.IsNullOrWhiteSpace(Model.Search.Location))
    {
        chips.Add(new("Location", Model.Search.Location, Url.Action("Index", "Items", new { query = Model.Search.Query, type = Model.Search.Type, category = Model.Search.Category, status = Model.Search.Status, page = 1 })!));
    }
}

<div class="browse-heading">
    <div>
        <h1>Browse reports</h1>
        @if (!Model.LoadFailed)
        {
            <p class="browse-count">Showing @Model.Items.Count @(Model.Items.Count == 1 ? "report" : "reports") on page @Model.Search.Page</p>
        }
        else
        {
            <p class="browse-count">Reports are temporarily unavailable.</p>
        }
    </div>
    <a class="btn btn-primary" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a>
</div>

<partial name="_SearchFilters" model="Model" />

@if (chips.Count > 0)
{
    <div class="browse-applied" aria-label="Applied filters">
        <span class="browse-applied-label">Applied</span>
        @foreach (var chip in chips)
        {
            <partial name="_FilterChip" model="chip" />
        }
        <a class="clear-all-filters" asp-controller="Items" asp-action="Index">Clear all</a>
    </div>
}

<section class="browse-results" aria-labelledby="browse-results-title">
    <div class="section-heading">
        <h2 id="browse-results-title" tabindex="-1">Results</h2>
    </div>
    @if (Model.LoadFailed)
    {
        <div class="tb-empty-state" role="alert">
            <h3>Reports could not load</h3>
            <p>Try again. Your filters will stay in place.</p>
            <a class="btn btn-primary" href="@Context.Request.Path@Context.Request.QueryString">Retry</a>
        </div>
    }
    else if (Model.Items.Count == 0)
    {
        <div class="tb-empty-state">
            <h3>@(chips.Count > 0 ? "No reports match these filters" : Model.Search.Page > 1 ? "No reports on this page" : "No active reports yet")</h3>
            <p>@(chips.Count > 0 ? "Try fewer search words or clear a filter." : Model.Search.Page > 1 ? "Go back to the previous page to keep browsing." : "When someone posts a lost or found item, it will appear here.")</p>
            <div class="browse-empty-actions">
                @if (chips.Count > 0)
                {
                    <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Index">Clear filters</a>
                }
                <a class="btn btn-primary" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a>
            </div>
        </div>
    }
    else
    {
        <div class="catalog-list">
            @foreach (var item in Model.Items)
            {
                <partial name="_CatalogRow" model="item" />
            }
        </div>
    }
</section>

<partial name="_Pagination" model="Model" />

@section Styles {
    <link rel="stylesheet" href="~/css/home-browse.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        if (window.location.search) {
            document.getElementById('browse-results-title')?.focus();
        }
    </script>
}
