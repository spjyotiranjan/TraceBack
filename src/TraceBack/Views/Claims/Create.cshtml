@model TraceBack.Controllers.ClaimPage
@{
    ViewData["Title"] = "Submit a claim";
}

<div class="claim-standalone">
    <a class="back-link" asp-controller="Items" asp-action="Details" asp-route-id="@Model.Item.Id"><partial name="_Icon" model='"arrow-left"' /> Back to item</a>
    <h1>Submit a claim</h1>
    <partial name="_ClaimForm" model="(Model, false)" />
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/claim.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/report-photo.js" asp-append-version="true" defer></script>
    <script src="~/js/claim.js" asp-append-version="true" defer></script>
}
