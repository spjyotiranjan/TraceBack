@model TraceBack.Controllers.ClaimPage
@{
    ViewData["Title"] = "Claim an item";
}

<div class="claim-page">
    <a class="back-link" asp-controller="Items" asp-action="Details" asp-route-id="@Model.Item.Id">← Back to item</a>

    <h1>Claim @Model.Item.Title</h1>
    <div class="claim-page__context">
        <p><span class="badge badge-type">@Model.Item.Type</span> <partial name="_StatusBadge" model="Model.Item.Status" /></p>
    </div>
    <p class="claim-page__privacy">Describe details that confirm this item belongs to you. Your message is private to the claim review and does not appear in public discussion.</p>

    <form asp-route="default" asp-route-controller="Claims" asp-route-action="Create" asp-route-itemId="@Model.Item.Id" method="post" class="form-card" novalidate>
        <partial name="_ValidationSummary" />

        <div class="mb-4">
            <label for="message" class="form-label">Ownership details <span class="required">required</span></label>
            <textarea id="message"
                      name="Message"
                      class="form-control"
                      rows="6"
                      maxlength="1000"
                      aria-describedby="message-help message-error">@Model.Form.Message</textarea>
            <div id="message-help" class="form-text">Include a distinguishing detail, where you last had it, or when you lost it.</div>
            <span id="message-error" class="text-danger small">@Html.ValidationMessage("Message")</span>
        </div>

        <button class="btn btn-primary" type="submit">Submit claim</button>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/detail-report.css" asp-append-version="true" />
}
