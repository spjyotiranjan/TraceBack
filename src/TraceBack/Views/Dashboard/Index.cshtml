@model TraceBack.Controllers.DashboardPage
@{
    ViewData["Title"] = "My dashboard";
    ViewData["RouteArt"] = "dashboard";
    var reportAction = new UiButton("Report an item", Href: Url.RouteUrl("default", new { controller = "Items", action = "Create" }));
    var browseFound = new UiButton("Browse found items", ButtonTone.Secondary,
        Href: Url.Action("Index", "Items", new { Type = "Found" }));
}

@section PageIntro {
    <div class="page-heading tb-dashboard-heading">
        <h1>My dashboard</h1>
        <p>Review your reports and follow your claims.</p>
    </div>
}

<section class="tb-workspace-section tb-dashboard-section" aria-labelledby="my-reports">
    <div class="section-heading tb-workspace-section__heading">
        <h2 id="my-reports">My reports</h2>
        @if (Model.Items.Count > 0)
        {
            <div class="tb-dashboard__desktop-action">
                <partial name="_Button" model="reportAction" />
            </div>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="tb-dashboard__reports-empty">
            <partial name="_RecoveryContent" model='@(new RecoveryContent("No reports yet", "You have not posted a report yet.",
                RecoveryArt.Reports, Primary: reportAction with { Tone = ButtonTone.Secondary }, Nested: true))' />
        </div>
    }
    else
    {
        <div class="tb-report-grid">
            @foreach (var item in Model.Items)
            {
                <partial name="_ItemCard" model="new ReportCard(item, ReportCardVariant.Dashboard)" />
            }
        </div>
    }
</section>

<section aria-labelledby="my-claims" class="tb-workspace-section tb-dashboard-section">
    <div class="tb-workspace-section__heading">
        <h2 id="my-claims">My claims</h2>
    </div>

    @if (Model.Claims.Count == 0)
    {
        <partial name="_RecoveryContent" model='@(new RecoveryContent("No claims yet", "You have not submitted a claim yet.",
            RecoveryArt.Claims, Primary: browseFound, Nested: true))' />
    }
    else
    {
        <div class="tb-claim-list">
            @foreach (var row in Model.Claims)
            {
                <partial name="_DashboardClaimRow" model="row" />
            }
        </div>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/home-browse.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/my-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/report-photo.js" asp-append-version="true" defer></script>
}
