@model TraceBack.Controllers.DashboardPage
@{ ViewData["Title"] = "My dashboard"; }
<div class="page-heading"><p class="eyebrow">Your activity</p><h1>My dashboard</h1><p>Review your reports and follow your claims.</p></div>
<section class="mb-5" aria-labelledby="my-reports"><div class="section-heading"><h2 id="my-reports">My reports</h2><a class="btn btn-primary" asp-controller="Items" asp-action="Create">Report an item</a></div>@if (Model.Items.Count == 0) { <div class="empty-state"><p>You have not posted a report yet.</p></div> } else { <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">@foreach (var item in Model.Items) { <div class="col"><partial name="_ItemCard" model="item" /></div> }</div> }</section>
<section aria-labelledby="my-claims" class="mb-5"><h2 id="my-claims">My claims</h2>@if (Model.Claims.Count == 0) { <div class="empty-state"><p>You have not submitted a claim yet.</p><a asp-controller="Items" asp-action="Index" asp-route-type="Found">Browse found items</a></div> } else { <div class="list-group">@foreach (var row in Model.Claims) { <div class="list-group-item d-flex justify-content-between align-items-start gap-3 flex-wrap"><div><h3 class="h6 mb-1">@if (row.Item is not null) { <a asp-controller="Items" asp-action="Details" asp-route-id="@row.Item.Id">@row.Item.Title</a> } else { <span>Item no longer available</span> }</h3><p class="small text-muted mb-0">Submitted @row.Claim.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p></div><span class="badge badge-status">@row.Claim.Status</span></div> }</div> }</section>
