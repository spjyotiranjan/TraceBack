@model TraceBack.Controllers.AdminPage
@{ ViewData["Title"] = "Admin dashboard"; }
<div class="page-heading"><p class="eyebrow">Campus overview</p><h1>Admin dashboard</h1><p>Review reports and ownership claims.</p></div>
<div class="row g-3 mb-5"><div class="col-sm-6"><div class="stat-card"><strong>@Model.ItemCount</strong><span>total reports</span></div></div><div class="col-sm-6"><div class="stat-card"><strong>@Model.ClaimCount</strong><span>total claims</span></div></div></div>
<section class="mb-5" aria-labelledby="review-claims"><h2 id="review-claims">Claims to review</h2>@if (!Model.Claims.Any(x => x.Claim.Status == "Pending")) { <div class="empty-state"><p>No pending claims.</p></div> } else { <div class="list-group">@foreach (var row in Model.Claims.Where(x => x.Claim.Status == "Pending")) { <article class="list-group-item"><div class="d-flex justify-content-between gap-2 flex-wrap"><h3 class="h5">@(row.Item?.Title ?? "Removed item")</h3><span class="badge badge-status">@row.Claim.Status</span></div><p class="mb-2">@row.Claim.Message</p><p class="small text-muted">Submitted @row.Claim.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p><div class="d-flex gap-2"><form asp-action="Decide" asp-route-id="@row.Claim.Id" method="post"><input type="hidden" name="approve" value="true" /><button class="btn btn-primary" type="submit" data-confirm="Approve this claim?">Approve</button></form><form asp-action="Decide" asp-route-id="@row.Claim.Id" method="post"><input type="hidden" name="approve" value="false" /><button class="btn btn-outline-danger" type="submit" data-confirm="Reject this claim?">Reject</button></form></div></article> }</div> }</section>
<section aria-labelledby="recent-reports"><h2 id="recent-reports">Recent reports</h2><div class="list-group">@foreach (var item in Model.Items) { <div class="list-group-item d-flex justify-content-between align-items-center gap-3 flex-wrap"><a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">@item.Title</a><span class="badge badge-status">@item.Status</span></div> }</div></section>
