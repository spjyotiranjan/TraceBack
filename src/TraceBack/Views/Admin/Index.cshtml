@model TraceBack.Controllers.AdminPage
@{
    ViewData["Title"] = "Admin dashboard";
    var pendingClaims = Model.Claims.Where(row => row.Claim.Status == "Pending").ToList();
}

<div class="page-heading tb-workspace-heading">
    <h1>Admin dashboard</h1>
    <p>Review private ownership claims and recent reports.</p>
</div>

<section class="tb-workspace-section" aria-labelledby="review-claims">
    <div class="tb-workspace-section__heading">
        <h2 id="review-claims">Claims to review <span class="tb-section-count">@pendingClaims.Count pending</span></h2>
        <p>Ownership messages are private. Approve or reject each claim after checking its details.</p>
    </div>

    @if (pendingClaims.Count == 0)
    {
        <div class="tb-empty-state tb-workspace-empty">
            <h3>No pending claims</h3>
            <p>New ownership requests will appear here for review.</p>
        </div>
    }
    else
    {
        <div class="tb-decision-list">
            @foreach (var row in pendingClaims)
            {
                <article class="tb-decision-row">
                    @if (!string.IsNullOrWhiteSpace(row.Item?.DisplayImageUrl))
                    {
                        <img class="tb-decision-row__thumbnail" src="@row.Item.DisplayImageUrl" alt="Photo for @row.Item.Title" width="120" height="90" loading="lazy" />
                    }
                    <div class="tb-decision-row__heading">
                        <div>
                            <p class="tb-decision-row__label">Claim for</p>
                            <h3>@(row.Item?.Title ?? "Removed item")</h3>
                        </div>
                        <partial name="_StatusBadge" model="row.Claim.Status" />
                    </div>

                    <p class="tb-decision-row__message">@row.Claim.Message</p>
                    <p class="tb-decision-row__date">Submitted @row.Claim.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p>

                    <div class="tb-decision-row__actions">
                        <form asp-action="Decide" asp-route-id="@row.Claim.Id" method="post" data-decision-form data-confirm="Approve the claim for @(row.Item?.Title ?? "the removed item")?">
                            <input type="hidden" name="approve" value="true" />
                            <button class="btn btn-primary" type="submit">Approve</button>
                        </form>
                        <form asp-action="Decide" asp-route-id="@row.Claim.Id" method="post" data-decision-form data-confirm="Reject the claim for @(row.Item?.Title ?? "the removed item")?">
                            <input type="hidden" name="approve" value="false" />
                            <button class="btn btn-outline-danger" type="submit">Reject</button>
                        </form>
                    </div>
                    <span class="visually-hidden" role="status" aria-live="polite" data-decision-status></span>
                </article>
            }
        </div>
    }
</section>

<section class="tb-workspace-section" aria-labelledby="campus-totals">
    <h2 id="campus-totals">Campus totals</h2>
    <dl class="tb-totals">
        <div><dt>Total reports</dt><dd>@Model.ItemCount</dd></div>
        <div><dt>Total claims</dt><dd>@Model.ClaimCount</dd></div>
    </dl>
</section>

<section class="tb-workspace-section" aria-labelledby="recent-reports">
    <h2 id="recent-reports">Recent reports</h2>
    @if (Model.Items.Count == 0)
    {
        <div class="tb-empty-state tb-workspace-empty">
            <h3>No reports yet</h3>
            <p>Reports will appear here when members post them.</p>
        </div>
    }
    else
    {
        <div class="tb-report-list">
            @foreach (var item in Model.Items)
            {
                <article class="tb-report-row">
                    <h3><a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h3>
                    <partial name="_StatusBadge" model="item.Status" />
                </article>
            }
        </div>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/account-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true" defer></script>
}

