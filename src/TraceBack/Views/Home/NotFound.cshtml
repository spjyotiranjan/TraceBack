@{
    ViewData["Title"] = "Page not found";
}

<div class="tb-recovery">
    <div class="tb-static-art" aria-hidden="true"><partial name="_RecordAperture" /></div>
    <h1>Page not found</h1>
    <p>This page may have moved or the report may no longer be available. Check the address or return to the home page.</p>
    <div class="tb-recovery__actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go home</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Index">Browse reports</a>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account-dashboard.css" asp-append-version="true" />
}
