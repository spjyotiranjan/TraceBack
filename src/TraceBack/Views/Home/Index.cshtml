@model List<Item>
@{ ViewData["Title"] = "Find what matters"; }
<section class="hero rounded-4 p-4 p-md-5 mb-5"><div class="row align-items-center g-4"><div class="col-lg-7">
    <p class="eyebrow">Campus lost and found</p><h1 class="display-4 fw-bold">Find what matters.</h1><p class="lead">A simple place to report missing belongings, share what you found, and bring things back to their people.</p>
    <form asp-controller="Items" asp-action="Index" method="get" class="d-flex gap-2 mt-4" role="search"><label class="visually-hidden" for="hero-search">Search belongings</label><input id="hero-search" name="Query" class="form-control" placeholder="Try keys, backpack, or library" /><button class="btn btn-primary" type="submit">Search</button></form>
    <div class="d-flex flex-wrap gap-2 mt-3"><a class="btn btn-outline-primary" asp-controller="Items" asp-action="Index" asp-route-type="Lost">Browse lost</a><a class="btn btn-outline-primary" asp-controller="Items" asp-action="Index" asp-route-type="Found">Browse found</a><a class="btn btn-accent" asp-controller="Items" asp-action="Create">Report an item</a></div>
    </div><div class="col-lg-5"><div class="hero-note"><span class="hero-mark" aria-hidden="true">↗</span><p class="h4">Every report brings someone closer to home.</p><p class="mb-0 text-muted">Share clear details, check recent posts, and keep claims private.</p></div></div></div></section>
<section aria-labelledby="recent-title" class="mb-5"><div class="section-heading"><div><p class="eyebrow mb-1">Latest activity</p><h2 id="recent-title">Recent reports</h2></div><a asp-controller="Items" asp-action="Index">Browse all <span aria-hidden="true">→</span></a></div>
    @if (Model.Count == 0) { <div class="empty-state"><p>No active reports yet.</p><a class="btn btn-primary" asp-controller="Items" asp-action="Create">Report an item</a></div> }
    else { <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">@foreach (var item in Model) { <div class="col"><partial name="_ItemCard" model="item" /></div> }</div> }
</section>
<section class="how-it-works mb-5" aria-labelledby="how-title"><p class="eyebrow">A clearer way back</p><h2 id="how-title">How it works</h2><div class="row g-4 mt-1"><div class="col-md-4"><span class="step">01</span><h3 class="h5">Report</h3><p>Tell the campus what you lost or found.</p></div><div class="col-md-4"><span class="step">02</span><h3 class="h5">Match</h3><p>Search reports and share details to confirm ownership.</p></div><div class="col-md-4"><span class="step">03</span><h3 class="h5">Reunite</h3><p>Arrange a safe handoff and close the report.</p></div></div></section>
