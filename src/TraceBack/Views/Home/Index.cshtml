@using Microsoft.AspNetCore.Http.Extensions
@model TraceBack.Controllers.HomePage
@{
    ViewData["Title"] = "Find what matters";
    var signedIn = User.Identity?.IsAuthenticated == true;
    ViewData["RouteArt"] = signedIn ? "home-member" : "home-guest";
    var browseUrl = Url.Action("Index", "Items");
    var createUrl = Url.RouteUrl("default", new { controller = "Items", action = "Create" });
}

<section class="home-hero" aria-labelledby="home-title">
    <h1 id="home-title">Find what matters.</h1>
    <div class="home-hero-aside" aria-hidden="true">
        <partial name="_HeroIllustration" />
    </div>
    <div class="home-hero-copy">
        @if (signedIn)
        {
            <p class="home-hero-intro">Search reports shared by your campus, or tell others what you lost or found.</p>
            <form asp-controller="Items" asp-action="Index" method="get" class="home-search" role="search">
                <partial name="_ReportSearchField" model='new ReportSearchField("home-query", "Search reports")' />
                <div class="home-search-fields">
                    <partial name="_Button" model='new UiButton("Search reports", Submit: true)' />
                </div>
            </form>
            <div class="home-hero-actions">
                <partial name="_Button" model='new UiButton("Browse reports", ButtonTone.Quiet, Href: browseUrl)' />
                <partial name="_Button" model='new UiButton("Report an item", ButtonTone.Quiet, Href: createUrl)' />
            </div>
        }
        else
        {
            <p class="home-hero-intro">A clear place for campus belongings that have been lost or found. Share a report, search what others have posted, and help an item find its way back.</p>
            <div class="home-hero-actions">
                <partial name="_Button" model='new UiButton("Sign in", Href: Url.Action("Login", "Account"))' />
                <partial name="_Button" model='new UiButton("Create account", ButtonTone.Secondary, Href: Url.Action("Register", "Account"))' />
            </div>
            <p class="home-access-note">Reports are available after sign-in.</p>
        }
    </div>
</section>

@if (signedIn)
{
    <section class="home-recent" aria-labelledby="recent-title">
        <div class="section-heading">
            <div>
                <h2 id="recent-title">Recent reports</h2>
                <p>See what has been shared lately.</p>
            </div>
            <a asp-controller="Items" asp-action="Index">Browse all reports</a>
        </div>
        @if (Model.RecentLoadFailed || Model.RecentItems.Count == 0)
        {
            var failed = Model.RecentLoadFailed;
            <div class="home-recent-status">
                <h3>@(failed ? "Recent reports could not load" : "No active reports yet")</h3>
                <p>@(failed ? "Try this page again, or open Browse to search the index." : "Share an item you lost or found to get the index started.")</p>
                <partial name="_Button" model='@(failed
                    ? new UiButton("Retry", Href: Context.Request.GetEncodedPathAndQuery())
                    : new UiButton("Report an item", Href: createUrl))' />
            </div>
        }
        else
        {
            <div class="tb-report-grid tb-report-grid--home">
                @foreach (var item in Model.RecentItems)
                {
                    <partial name="_ItemCard" model="new ReportCard(item, ReportCardVariant.Home)" />
                }
            </div>
        }
    </section>
    <section class="process-section" aria-labelledby="process-title">
        <div class="section-heading">
            <div>
                <h2 id="process-title">Report. Search. Reunite.</h2>
                <p>Share a report, look for useful details, and arrange a safe handoff after confirming ownership.</p>
            </div>
        </div>
    </section>
}
else
{
    <partial name="_ProcessPath" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-browse.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/report-search.js" asp-append-version="true" defer></script>
    <script src="~/js/report-photo.js" asp-append-version="true" defer></script>
}
