@model TraceBack.Controllers.HomePage
@{
    ViewData["Title"] = "Find what matters";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
        <h1 id="home-title">Find what matters.</h1>
        <p class="home-hero-intro">A clear place for campus belongings that have been lost or found. Share a report, search what others have posted, and help an item find its way back.</p>
        @if (signedIn)
        {
            <form asp-controller="Items" asp-action="Index" method="get" class="home-search" role="search">
                <label for="home-query">Search reports</label>
                <div class="home-search-fields">
                    <input id="home-query" name="Query" class="form-control" placeholder="Item name or description" />
                    <button class="btn btn-primary" type="submit">Search reports</button>
                </div>
            </form>
            <div class="home-hero-actions">
                <a class="btn btn-outline-primary" asp-controller="Items" asp-action="Index">Browse reports</a>
                <a class="btn btn-primary" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a>
            </div>
        }
        else
        {
            <p class="home-access-note">Reports are available after sign-in.</p>
            <div class="home-hero-actions">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
                <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Create account</a>
            </div>
        }
    </div>
    <div class="home-hero-aside" aria-hidden="true">
        <partial name="_RecordAperture" />
        <span class="home-aside-caption">Every report is a useful place to start.</span>
        @if (signedIn && Model.RecentItems.FirstOrDefault(item => !string.IsNullOrWhiteSpace(item.DisplayImageUrl)) is { } recent)
        {
            <img class="home-record-photo" src="@recent.DisplayImageUrl" alt="" width="320" height="160" />
        }
    </div>
</section>

@if (signedIn)
{
    <section class="home-recent" aria-labelledby="recent-title">
        <div class="section-heading">
            <div>
                <h2 id="recent-title">Recent reports</h2>
                <p>See what has been shared lately.</p>
            </div>
            <a asp-controller="Items" asp-action="Index">Browse all reports</a>
        </div>
        @if (Model.RecentLoadFailed)
        {
            <div class="tb-empty-state" role="alert">
                <h3>Recent reports could not load</h3>
                <p>Try this page again. Your report and account have not changed.</p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Retry</a>
            </div>
        }
        else if (Model.RecentItems.Count == 0)
        {
            <div class="tb-empty-state">
                <h3>No active reports yet</h3>
                <p>Share an item you lost or found to get the index started.</p>
                <a class="btn btn-primary" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a>
            </div>
        }
        else
        {
            <div class="catalog-list">
                @foreach (var item in Model.RecentItems)
                {
                    <partial name="_CatalogRow" model="item" />
                }
            </div>
        }
    </section>
}

<partial name="_ProcessPath" />

<nav class="home-route-art" aria-label="Find your next step">
    <svg viewBox="0 0 800 140" fill="none" aria-hidden="true" focusable="false">
        <path d="M32 70h200l80-40h176l80 80h200M232 70l80 40h176l80-80h200" stroke="currentColor" stroke-width="3" />
        <circle cx="32" cy="70" r="10" fill="currentColor" /><circle cx="400" cy="30" r="10" fill="currentColor" /><circle cx="768" cy="110" r="10" fill="currentColor" />
    </svg>
    <a asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report what happened</a>
    <a asp-controller="Items" asp-action="Index">Browse the index</a>
    <a asp-controller="Dashboard" asp-action="Index">Follow your reports and claims</a>
</nav>

@section Styles {
    <link rel="stylesheet" href="~/css/home-browse.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        const path = document.querySelector('.process-route');
        if (path && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const observer = new IntersectionObserver(entries => {
                if (entries[0].isIntersecting) {
                    path.classList.add('is-visible');
                    observer.disconnect();
                }
            }, { threshold: 0.3 });
            observer.observe(path);
        }
    </script>
}
