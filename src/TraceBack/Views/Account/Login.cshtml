@model LoginForm
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-page">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in</h1>
    <p class="text-muted">Return to your reports and claims.</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="form-card" novalidate>
        <partial name="_ValidationSummary" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email address</label>
            <input asp-for="Email" aria-describedby="Email-error" class="form-control" autocomplete="email" />
            <span id="Email-error" asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" aria-describedby="Password-error" type="password" class="form-control" autocomplete="current-password" />
            <span id="Password-error" asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>

    <p class="mt-3">
        New here? <a asp-action="Register">Create an account</a>.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
