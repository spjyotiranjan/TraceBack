@{
    const string heading = "Access denied";
    const string help = "Your account does not have permission to open this page. You can return to the home page and continue with the areas available to you.";
    ViewData["Title"] = heading;
    ViewData["RouteArt"] = "denied";
}

<partial name="_RecoveryContent" model='@(new RecoveryContent(heading, help, RecoveryArt.Access,
    Primary: new UiButton("Go home", Href: Url.Action("Index", "Home")!), FullPage: true))' />

@section Styles {
    <link rel="stylesheet" href="~/css/recovery-pages.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/recovery-focus.js" asp-append-version="true" defer></script>
}
