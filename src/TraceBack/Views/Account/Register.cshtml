@model RegisterForm
@{
    Layout = "~/Views/Account/_AuthLayout.cshtml";
    ViewData["Title"] = "Create an account";
    ViewData["AuthDescription"] = "Use your account to post reports and track claims.";
    ViewData["AuthAction"] = "Register";
    ViewData["AuthSubmit"] = "Create account";
}

<div class="tb-field">
    <label asp-for="Name" class="form-label">Full name</label>
    <input asp-for="Name" tb-field tb-error="Name-validation" class="form-control" autocomplete="name" />
    <span id="Name-validation" asp-validation-for="Name" class="tb-field__error"></span>
</div>

<div class="tb-field">
    <label asp-for="Email" class="form-label">Email address</label>
    <input asp-for="Email" tb-field tb-error="Email-validation" class="form-control" autocomplete="email" />
    <span id="Email-validation" asp-validation-for="Email" class="tb-field__error"></span>
</div>

<div class="tb-field">
    <label asp-for="Password" class="form-label">Password (at least 8 characters)</label>
    <input asp-for="Password" tb-field tb-error="Password-validation" type="password" class="form-control" autocomplete="new-password" />
    <span id="Password-validation" asp-validation-for="Password" class="tb-field__error"></span>
</div>

@section AlternateAccount {
    Already registered? <a asp-controller="Account" asp-action="Login">Sign in</a>.
}
