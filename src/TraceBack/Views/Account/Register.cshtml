@model RegisterForm
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-page">
    <p class="eyebrow">Join TraceBack</p>
    <h1>Create an account</h1>
    <p class="text-muted">Use your account to post reports and track claims.</p>

    <form asp-action="Register" method="post" class="form-card" novalidate>
        <partial name="_ValidationSummary" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Full name</label>
            <input asp-for="Name" class="form-control" autocomplete="name" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email address</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password (at least 8 characters)</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary w-100" type="submit">Create account</button>
    </form>

    <p class="mt-3">
        Already registered? <a asp-action="Login">Sign in</a>.
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
