@model TraceBack.Models.Item

<dl class="detail-report__fact-list">
    <div><dt>Category</dt><dd>@Model.Category</dd></div>
    <div><dt>Reported</dt><dd>@Model.DateReported.ToString("d MMM yyyy")</dd></div>
    <div class="detail-report__location-fact">
        <dt>Location description</dt>
        <dd>
            @Model.Location
            <span class="d-block form-text">Written by the reporter. This is not a verified address.</span>
        </dd>
    </div>
</dl>