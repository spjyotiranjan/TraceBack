<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · TraceBack</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><nav class="navbar navbar-expand-lg container" aria-label="Primary navigation"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-symbol" aria-hidden="true">↗</span> TraceBack</a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#site-nav" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu"><span class="navbar-toggler-icon"></span><span class="ms-2 small">Menu</span></button><div class="collapse navbar-collapse" id="site-nav"><ul class="navbar-nav mx-lg-auto gap-lg-3"><li class="nav-item"><a class="nav-link" asp-controller="Items" asp-action="Index">Browse</a></li><li class="nav-item"><a class="nav-link" asp-route="default" asp-route-controller="Items" asp-route-action="Create">Report an item</a></li></ul><div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2 py-2 py-lg-0">@if (User.Identity?.IsAuthenticated == true) { <a class="nav-link" asp-controller="Dashboard" asp-action="Index">My dashboard</a> @if (User.IsInRole("Admin")) { <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a> } <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-primary" type="submit">Sign out</button></form> } else { <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-primary" asp-controller="Account" asp-action="Register">Create account</a> }</div></div></nav></header>
<main id="main-content" class="container main-content">@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> } @RenderBody()</main>
<footer class="site-footer"><div class="container d-flex justify-content-between flex-wrap gap-3"><p class="mb-0">TraceBack helps campus belongings find their way home.</p><a asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
