<!DOCTYPE html>
<html lang="en" class="@(User.Identity?.IsAuthenticated == true ? "tb-member-shell" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · TraceBack</title>
    <script>
        (() => {
            let choice = 'system';
            try {
                const saved = localStorage.getItem('traceback.theme.v1');
                if (saved === 'light' || saved === 'dark' || saved === 'system') choice = saved;
            } catch { /* System preference remains available when storage is blocked. */ }
            document.documentElement.dataset.themeChoice = choice;
            document.documentElement.dataset.theme = choice === 'system'
                ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : choice;
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/record-graphics.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    @{
        var member = User.Identity?.IsAuthenticated == true;
        var controller = ViewContext.RouteData.Values["controller"] as string;
        var action = ViewContext.RouteData.Values["action"] as string;
    }
    <header class="site-header tb-glass">
        <a class="tb-brand" aria-label="TraceBack Home" aria-current="@(controller == "Home" && action == "Index" ? "page" : null)" asp-controller="Home" asp-action="Index">
            <svg class="brand-symbol" viewBox="0 0 120 120" width="24" height="24" aria-hidden="true" focusable="false">
                <use href="@Url.Content("~/icons/traceback-mark.svg")#reunion"></use>
            </svg> TraceBack
        </a>
        @if (member)
        {
            <nav class="tb-desktop-nav" aria-label="Member navigation">
                <partial name="_MemberDestinations" model="false" />
            </nav>
        }
        <div class="tb-shell-actions">
            <partial name="_ThemeControl" />
            <div class="tb-desktop-actions">
                <partial name="_ShellAccountActions" />
            </div>
            <details class="tb-disclosure tb-mobile-menu" data-shell-disclosure>
                <summary class="tb-shell-trigger" aria-label="Menu">
                    <span class="tb-trigger-open"><partial name="_Icon" model='"menu"' /></span>
                    <span class="tb-trigger-close"><partial name="_Icon" model='"x"' /></span>
                </summary>
                <div class="tb-shell-panel">
                    <p class="tb-shell-panel-title">Menu</p>
                    <partial name="_ShellAccountActions" />
                </div>
            </details>
        </div>
    </header>

    @if (member)
    {
        <nav class="tb-member-dock tb-glass" aria-label="Member navigation">
            <partial name="_MemberDestinations" model="true" />
        </nav>
    }

    <main id="main-content" class="container main-content" tabindex="-1">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status">@success</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex justify-content-between flex-wrap gap-3">
            <p class="mb-0">TraceBack helps campus belongings find their way home.</p>
            <a aria-current="@(controller == "Home" && action == "Privacy" ? "page" : null)" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/shell.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
