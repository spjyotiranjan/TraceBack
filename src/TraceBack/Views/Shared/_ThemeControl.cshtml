<fieldset class="tb-theme-control" data-theme-control>
    <legend>Theme</legend>
    <label><input type="radio" name="theme-choice" value="light" /> Light</label>
    <label><input type="radio" name="theme-choice" value="dark" /> Dark</label>
    <label><input type="radio" name="theme-choice" value="system" checked /> System</label>
</fieldset>
