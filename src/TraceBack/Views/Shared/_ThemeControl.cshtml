<fieldset class="tb-appearance" data-theme-control hidden>
    <legend class="visually-hidden">Appearance</legend>
    <div class="tb-appearance__options">
        @foreach (var (value, label, icon) in new[] { ("system", "System", "monitor"), ("light", "Light", "sun"), ("dark", "Dark", "moon") })
        {
            <input class="visually-hidden" type="radio" name="tb-appearance" value="@value" id="appearance-@value" />
            <label for="appearance-@value"><partial name="_Icon" model="icon" />@label</label>
        }
    </div>
</fieldset>
