@{
    var fieldIds = Model as IReadOnlyDictionary<string, string?>;
}
<div class="tb-feedback tb-feedback--error tb-validation-summary" data-tb-validation-summary role="alert"
     tabindex="-1" hidden="@ViewData.ModelState.IsValid">
    <div class="tb-feedback__message"><partial name="_Icon" model='"triangle-alert"' /><strong>Please correct the following:</strong></div>
    <ul>
        @foreach (var entry in ViewData.ModelState)
        {
            var id = fieldIds is not null && fieldIds.TryGetValue(entry.Key, out var customId)
                ? customId : string.IsNullOrEmpty(entry.Key) ? null
                    : Microsoft.AspNetCore.Mvc.Rendering.TagBuilder.CreateSanitizedId(entry.Key, Html.IdAttributeDotReplacement);
            foreach (var error in entry.Value.Errors)
            {
                var message = string.IsNullOrWhiteSpace(error.ErrorMessage) ? "Check the submitted value." : error.ErrorMessage;
                <li>
                    @if (!string.IsNullOrEmpty(id))
                    {
                        <a href="#@Uri.EscapeDataString(id)">@message</a>
                    }
                    else
                    {
                        @message
                    }
                </li>
            }
        }
    </ul>
</div>
