@model Item
<article class="card item-card h-100">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img class="card-img-top item-image" src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" /> }
    else { <div class="item-placeholder" aria-hidden="true">TB</div> }
    <div class="card-body d-flex flex-column">
        <div class="d-flex gap-2 flex-wrap mb-2"><span class="badge badge-type">@Model.Type</span><span class="badge badge-status">@Model.Status</span></div>
        <h3 class="h5 card-title"><a class="stretched-link text-decoration-none" asp-controller="Items" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
        <p class="text-muted mb-1">@Model.Location</p><p class="small text-muted mt-auto mb-0">Reported @Model.DateReported.ToString("d MMM yyyy")</p>
    </div>
</article>
