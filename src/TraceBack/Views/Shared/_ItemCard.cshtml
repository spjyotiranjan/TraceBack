@model ReportCard
@{
    var item = Model.Item;
    var imageUrl = item.DisplayImageUrl;
    var variant = Model.Variant.ToString().ToLowerInvariant();
}

<article class="tb-report-card tb-report-card--@variant" data-record-id="@item.Id">
    <div class="tb-report-card__media">
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <img data-report-photo src="@imageUrl" alt="Photo for @item.Title" width="400" height="300" loading="lazy" />
            <div class="tb-report-card__placeholder" data-photo-error hidden>
                <partial name="_Icon" model='"image-off"' />
                <span>Photo unavailable</span>
            </div>
        }
        else
        {
            <div class="tb-report-card__placeholder">
                <partial name="_Icon" model='"image"' />
                <span>No photo provided</span>
            </div>
        }
    </div>
    <div class="tb-report-card__body">
        <div class="tb-report-card__badges">
            <partial name="_StatusBadge" model="item.Type" />
            <partial name="_StatusBadge" model="item.Status" />
        </div>
        <h3 class="tb-report-card__title">
            <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
        </h3>
        <p class="tb-report-card__location">
            <partial name="_Icon" model='"map-pin"' />
            <span>@item.Location</span>
        </p>
        <p class="tb-report-card__metadata">
            @if (!string.IsNullOrWhiteSpace(item.Category))
            {
                <span>@item.Category</span><span aria-hidden="true">·</span>
            }
            <time datetime="@item.DateReported.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)">Reported @item.DateReported.ToString("d MMM yyyy")</time>
        </p>
    </div>
</article>
