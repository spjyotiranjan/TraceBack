@model TraceBack.Controllers.BrowsePage
@if (!Model.LoadFailed && Model.Items.Count > 0)
{
    <nav class="browse-pagination" aria-label="Result pages">
        <ul class="pagination">
            @if (Model.Search.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link" rel="prev" href="@Url.Action("Index", "Items", Model.PageRoute(Model.Search.Page - 1))">Previous</a>
                </li>
            }
            <li class="page-item active"><span class="page-link" aria-current="page">Page @Model.Search.Page</span></li>
            @if (Model.HasNext)
            {
                <li class="page-item">
                    <a class="page-link" rel="next" href="@Url.Action("Index", "Items", Model.PageRoute(Model.Search.Page + 1))">Next</a>
                </li>
            }
        </ul>
    </nav>
}
