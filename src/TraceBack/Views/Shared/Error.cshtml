@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="tb-recovery">
    <h1>Something went wrong</h1>
    <p>We could not load this page. Please try again. If the problem continues, contact your campus service desk.</p>
    <div class="tb-recovery__actions">
        <button class="btn btn-primary" type="button" data-retry>Try again</button>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Go home</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="tb-recovery__reference">Reference: <code>@Model.RequestId</code></p>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/account-dashboard.css" asp-append-version="true" />
}
